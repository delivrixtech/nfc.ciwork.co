---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { states } from '../data/site';

const stateSlug = (state: string) => state.toLowerCase().replaceAll(' ', '-');
---

<BaseLayout
  title="Browse Business Filing Requirements by State | NFC"
  description="Browse business formation states and begin a state-specific filing with National Filing Corporation. Florida guidance is available now."
>
  <Header current="states" />
  <main id="main-content" class="inner-main">
    <section class="inner-hero inner-hero--states">
      <p class="service-kicker"><span></span>Browse by state</p>
      <h1>Start in the state<br />that fits your business.</h1>
      <p>Every state has its own forms, fees, and timelines. Select a location to begin; detailed Florida guidance is available now.</p>
    </section>

    <section class="state-directory section" aria-labelledby="state-directory-title">
      <header>
        <p>50 states + D.C.</p>
        <h2 id="state-directory-title">Choose a jurisdiction.</h2>
      </header>
      <div class="state-directory__grid">
        {states.map((state, index) => {
          const florida = state === 'Florida';
          const href = florida
            ? '/statedetails-florida/'
            : `/business-formation/?state=${stateSlug(state)}`;
          return (
            <a href={href} data-pointer-react>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{state}</strong>
              {florida && <small>Guide available</small>}
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          );
        })}
      </div>
    </section>

    <FinalCTA compact />
  </main>
  <Footer />
</BaseLayout>
