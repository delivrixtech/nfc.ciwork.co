<section class="section services" id="services" aria-labelledby="services-title">
  <header class="section-heading section-heading--center">
    <h2 id="services-title">A modern system for<br />business formation.</h2>
  </header>

  <div class="platform-grid">
    <a class="platform-card platform-card--route" href="/llc-formation/" data-pointer-react data-cursor-label="LLC">
      <div class="platform-card__header">
        <span class="platform-card__icon" aria-hidden="true"><i class="ph ph-path"></i></span>
        <h3>Guided preparation</h3>
      </div>
      <div class="platform-visual platform-visual--route" aria-hidden="true">
        <span class="platform-flow__line"></span>
        <span class="platform-flow__node platform-flow__node--intake"><i class="ph ph-note-pencil"></i></span>
        <span class="platform-flow__node platform-flow__node--review"><i class="ph ph-magnifying-glass"></i></span>
        <span class="platform-flow__node platform-flow__node--file"><i class="ph ph-files"></i></span>
        <span class="platform-flow__node platform-flow__node--complete"><i class="ph ph-check"></i></span>
      </div>
      <p>A simple intake turns your details into a filing-ready package.</p>
    </a>

    <a class="platform-card platform-card--consult" href="/c-corporation/" data-pointer-react data-cursor-label="C CORP">
      <div class="platform-card__header">
        <span class="platform-card__icon" aria-hidden="true"><i class="ph ph-headset"></i></span>
        <h3>Clear, capable consultation</h3>
      </div>
      <div class="platform-visual platform-visual--documents" aria-hidden="true">
        <span class="platform-document platform-document--back"><i class="ph ph-file-text"></i></span>
        <span class="platform-document platform-document--middle"><i class="ph ph-identification-card"></i></span>
        <span class="platform-document platform-document--front"><i class="ph ph-stamp"></i></span>
        <span class="platform-document__status"><i class="ph ph-check"></i></span>
      </div>
      <p>Real specialists explain requirements and catch issues early.</p>
    </a>

    <a class="platform-card platform-card--state" href="/s-corporation/" data-pointer-react data-cursor-label="S CORP">
      <div class="platform-card__header">
        <span class="platform-card__icon" aria-hidden="true"><i class="ph ph-map-pin-area"></i></span>
        <h3>State-ready filing</h3>
      </div>
      <div class="platform-visual platform-visual--state" aria-hidden="true">
        <span class="platform-state__signal platform-state__signal--one"></span>
        <span class="platform-state__signal platform-state__signal--two"></span>
        <span class="platform-state__signal platform-state__signal--three"></span>
        <span class="platform-state__pin"><i class="ph ph-map-pin-area"></i></span>
      </div>
      <p>Prepared around the rules and timing of your chosen state.</p>
    </a>

    <a
      class="platform-card platform-card--media platform-card--media-one"
      href="/nonprofit-organization/"
      data-pointer-react
      data-cursor-label="NONPROFIT"
      aria-label="Explore nonprofit organization filing"
    >
      <img
        src="/media/nfc-rail-01.jpg"
        alt="An NFC specialist handing a completed business filing folder to a founder"
        width="1086"
        height="1448"
        loading="lazy"
      />
      <div class="platform-card__media-copy"><strong>Expert-prepared documents</strong></div>
    </a>

    <a
      class="platform-card platform-card--media platform-card--media-two"
      href="/registered-agent/"
      data-pointer-react
      data-cursor-label="AGENT"
      aria-label="Explore registered agent service"
    >
      <img
        src="/media/nfc-rail-02.jpg"
        alt="An NFC filing specialist reviewing formation documents with a founder"
        width="1086"
        height="1448"
        loading="lazy"
      />
      <div class="platform-card__media-copy"><strong>A person when it matters</strong></div>
    </a>

    <a class="platform-card platform-card--review" href="/business-renewal/" data-pointer-react data-cursor-label="RENEW">
      <div class="platform-card__header">
        <span class="platform-card__icon" aria-hidden="true"><i class="ph ph-seal-check"></i></span>
        <h3>Accuracy-first review</h3>
      </div>
      <div class="platform-visual platform-visual--review" aria-hidden="true">
        <span class="platform-review__orbit"></span>
        <span class="platform-review__seal"><i class="ph ph-seal-check"></i></span>
      </div>
      <p>Every package is checked before it reaches the state.</p>
    </a>
  </div>
</section>
