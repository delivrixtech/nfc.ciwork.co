---
import { plans } from '../data/site';

const planArt = [
  [{ icon: 'ph-rocket-launch', position: 'bottom-start', offset: 76 }],
  [{ icon: 'ph-seal-check', position: 'top-center', offset: -76 }],
  [{ icon: 'ph-globe-hemisphere-west', position: 'bottom-center', offset: 76 }],
  [
    { icon: 'ph-map-pin-line', position: 'top-start', offset: -76 },
    { icon: 'ph-file-text', position: 'bottom-end', offset: 76 },
  ],
] as const;

const planTitles = [
  ['Basic', 'Filing'],
  ['Essential', 'Filing'],
  ['Foreign Entity', 'BOI Review'],
  ['Registered', 'Agent'],
] as const;
---

<section class="section pricing" id="pricing" aria-label="NFC filing plans">
  <h2 class="visually-hidden">Choose your filing package</h2>
  <ul class="pricing-shapes" data-service-cases aria-label="NFC filing packages">
    {plans.map((plan, index) => (
      <li
        class:list={['price-shape', `price-shape--${index + 1}`, { 'price-shape--featured': plan.featured }]}
        data-service-case
        data-featured={plan.featured ? 'true' : undefined}
      >
        <a
          class="price-shape__surface"
          href={plan.href}
          aria-label={`${plan.name}, $${plan.price} one-time — view plan`}
        >
          {planArt[index].map((art) => (
            <span
              class:list={['price-shape__art', `is-${art.position}`]}
              style={`--art-rest-y: ${art.offset}px`}
              data-shape-art
              data-art-offset={art.offset}
              aria-hidden="true"
            >
              <i class:list={['ph', art.icon]}></i>
            </span>
          ))}

          <div class="price-shape__heading">
            <h3 aria-label={plan.name}>
              {planTitles[index].map((line) => <span>{line}</span>)}
            </h3>
            <p class="price-card__price" aria-label={`$${plan.price}, one-time`}>
              <span aria-hidden="true">$</span><strong>{plan.price}</strong><small>one-time</small>
            </p>
          </div>

          <div class="price-shape__detail">
            <p>{plan.description}</p>
            <span class="price-shape__link" aria-hidden="true">
              <span>{plan.name === 'Foreign Entity BOI Review' ? 'Check eligibility' : 'Get started'}</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
