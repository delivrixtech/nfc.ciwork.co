---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FinalCTA from './FinalCTA.astro';
import { serviceBySlug, type ServicePage } from '../data/services';

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const related = service.related.map((slug) => serviceBySlug[slug]).filter(Boolean);
const siteUrl = Astro.site ?? new URL('https://nfc.ciwork.co');
const serviceUrl = new URL(service.path, siteUrl).href;
const serviceSchema = {
  '@type': 'Service',
  '@id': `${serviceUrl}#service`,
  name: service.shortTitle,
  serviceType: service.shortTitle,
  description: service.description,
  url: serviceUrl,
  provider: { '@id': new URL('/#organization', siteUrl).href },
  areaServed: { '@type': 'Country', name: 'United States' },
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${serviceUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', siteUrl).href },
    { '@type': 'ListItem', position: 3, name: service.shortTitle, item: serviceUrl },
  ],
};
const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${serviceUrl}#faq`,
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title={service.seoTitle}
  description={service.description}
  image={service.image}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <Header current="services" />
  <main id="main-content" class:list={['service-main', `service-accent--${service.accent}`]}>
    <section class="service-hero">
      <nav class="service-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
        <a href="/services/">Services</a>
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
        <span aria-current="page">{service.shortTitle}</span>
      </nav>

      <div class="service-hero__grid">
        <div class="service-hero__copy">
          <p class="service-kicker"><span></span>{service.eyebrow}</p>
          <h1>{service.title}</h1>
          <p class="service-hero__lead">{service.lead}</p>
          <div class="service-hero__actions">
            <a
              class="button button--primary"
              href={`/business-formation/?service=${service.slug}`}
              data-pointer-react
            >
              <span>Start your filing</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
            <a class="service-text-link" href="/browse-by-state/" data-pointer-react>
              <span>Browse by state</span>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <figure
          class="service-hero__media"
          data-pointer-react
          data-cursor-label="DISCOVER"
          data-cursor-icon="ph-arrow-down-right"
        >
          <img src={service.image} alt={service.imageAlt} width="1536" height="1024" />
          <figcaption>
            <i class="ph ph-seal-check" aria-hidden="true"></i>
            <span>Expert-prepared<br />for your state</span>
          </figcaption>
        </figure>
      </div>

      <ul class="service-facts" aria-label={`${service.shortTitle} highlights`}>
        {service.facts.map((fact, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{fact}</strong></li>
        ))}
      </ul>
    </section>

    <section class="service-overview section" aria-labelledby="service-overview-title">
      <div class="service-section-label">
        <span>01</span>
        <p>Understand the structure</p>
      </div>
      <div class="service-overview__body">
        <h2 id="service-overview-title">{service.overviewTitle}</h2>
        <div class="service-overview__copy">
          {service.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="service-benefits section" aria-labelledby="service-benefits-title">
      <header class="service-section-heading">
        <div class="service-section-label"><span>02</span><p>What you gain</p></div>
        <h2 id="service-benefits-title">Built around the details<br />that matter.</h2>
      </header>
      <div class="service-benefit-grid">
        {service.benefits.map((benefit, index) => (
          <article
            class:list={['service-benefit-card', `is-${benefit.accent}`]}
            data-pointer-react
            style={`--card-order:${index}`}
          >
            <div class="service-benefit-card__top">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i class:list={['ph', benefit.icon]} aria-hidden="true"></i>
            </div>
            <div>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="service-process section" aria-labelledby="service-process-title">
      <header class="service-section-heading service-section-heading--split">
        <div class="service-section-label"><span>03</span><p>How it works</p></div>
        <h2 id="service-process-title">A clear path<br />from details to done.</h2>
      </header>
      <ol class="service-process__list">
        {service.steps.map((step, index) => (
          <li data-pointer-react>
            <span class="service-process__number">{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{step.title}</h3><p>{step.description}</p></div>
            <i class="ph ph-arrow-down-right" aria-hidden="true"></i>
          </li>
        ))}
      </ol>
    </section>

    <section class="service-faq section" aria-labelledby="service-faq-title">
      <header class="service-section-heading service-section-heading--split">
        <div class="service-section-label"><span>04</span><p>Good to know</p></div>
        <h2 id="service-faq-title">Questions,<br />answered clearly.</h2>
      </header>
      <div class="service-faq__list" data-faq-list>
        {service.faqs.map((faq, index) => (
          <article class:list={['service-faq__item', { 'is-open': index === 0 }]}>
            <h3>
              <button
                type="button"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`${service.slug}-faq-${index}`}
                id={`${service.slug}-faq-trigger-${index}`}
                data-faq-trigger
              >
                <span>{faq.question}</span>
                <span class="service-faq__toggle" aria-hidden="true"><i></i><i></i></span>
              </button>
            </h3>
            <div
              class="service-faq__panel"
              id={`${service.slug}-faq-${index}`}
              role="region"
              aria-labelledby={`${service.slug}-faq-trigger-${index}`}
              hidden={index !== 0}
              data-faq-panel
            >
              <div><p>{faq.answer}</p></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="service-related section" aria-labelledby="service-related-title">
      <header class="service-related__heading">
        <p>Continue exploring</p>
        <h2 id="service-related-title">Related services.</h2>
      </header>
      <div class="service-related__grid">
        {related.map((item, index) => (
          <a
            class:list={['service-related-card', `is-${item.accent}`]}
            href={item.path}
            data-pointer-react
            data-cursor-label="OPEN"
            data-cursor-icon="ph-arrow-up-right"
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p>{item.eyebrow}</p>
              <h3>{item.shortTitle}</h3>
            </div>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </section>

    <FinalCTA compact />
  </main>
  <Footer />
</BaseLayout>
